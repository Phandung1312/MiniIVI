@startuml ARCHITECTURE

title MiniIVI Architecture Overview

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 85
skinparam ranksep 90
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #355070
skinparam ComponentBorderColor #355070
skinparam ComponentBackgroundColor #F7FAFC
skinparam PackageBorderColor #607D8B
skinparam PackageBackgroundColor #F8FAFC
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B7791F

legend bottom
  solid  = Binder, state, and command flow
  dashed = Intent, activity-launch, and navigation action flow
  dotted = shared cross-process contract dependency
endlegend

package "Android Automotive OS" as AAOS {
  component "AAOS car_service\nCarPropertyManager / CarAudioManager" as AAOS_CAR
  component "Platform services\nAudio / Display / Settings" as AAOS_PLATFORM
}

package "MiniIVI backend process" as BACKEND {
  component "CarService\nprivileged Binder backend\nIMiniIviCarService (AIDL)" as CAR_SERVICE
}

package "MiniIVI client processes" as CLIENTS {
  component "CarSystemUI\nsystem navigation and controls" as CAR_SYSTEM_UI
  component "NavigationStateService\nsignature-protected Binder endpoint\nINavigationStateService (AIDL)" as NAV_SERVICE
  component "CarLauncher\nhome and dashboard" as CAR_LAUNCHER
}

package "Shared contract" as CONTRACT {
  component "navigation-contract\nAIDL + destination constants" as NAV_CONTRACT
}

AAOS_CAR --> CAR_SERVICE : vehicle data + commands
AAOS_PLATFORM --> CAR_SERVICE : platform services + fallback

CAR_SYSTEM_UI <--> CAR_SERVICE : Binder\nUI controls + state
CAR_LAUNCHER <--> CAR_SERVICE : Binder\nlauncher commands + state

CAR_SYSTEM_UI -[dashed]-> CAR_LAUNCHER : key / Intent\nnavigation action
CAR_LAUNCHER --> NAV_SERVICE : bind +\nreportDestination()
NAV_SERVICE --> CAR_SYSTEM_UI : map destination +\nupdate navigation state

NAV_CONTRACT ..> CAR_LAUNCHER : AIDL + constants
NAV_CONTRACT ..> NAV_SERVICE : AIDL + constants

@enduml
