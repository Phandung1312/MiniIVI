<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/navigation_bar_height"
    android:background="@drawable/navigation_bar_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp">

    <ImageButton
        android:id="@+id/nav_home"
        style="@style/NavigationButton"
        android:contentDescription="@string/navigation_home"
        android:src="@drawable/ic_nav_home" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/climate_status"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/climate_waiting"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/temp_left_down"
            style="@style/ClimateRoundButton"
            android:contentDescription="@string/temperature_decrease"
            android:text="−" />

        <TextView
            android:id="@+id/temp_left"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--°C"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/temp_left_up"
            style="@style/ClimateRoundButton"
            android:contentDescription="@string/temperature_increase"
            android:text="+" />

        <ToggleButton
            android:id="@+id/climate_ac"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/navigation_button_background"
            android:textColor="#FFFFFFFF"
            android:textOff="@string/climate_ac"
            android:textOn="@string/climate_ac" />

        <Button
            android:id="@+id/temp_right_down"
            style="@style/ClimateRoundButton"
            android:contentDescription="@string/temperature_decrease"
            android:text="−" />

        <TextView
            android:id="@+id/temp_right"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--°C"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/temp_right_up"
            style="@style/ClimateRoundButton"
            android:contentDescription="@string/temperature_increase"
            android:text="+" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/nav_control_center"
        style="@style/NavigationButton"
        android:contentDescription="@string/navigation_control_center"
        android:src="@drawable/ic_control_center" />
</LinearLayout>
